    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ------------------------------\n// Intelligent Lead Processing Platform\n// Normalization Layer\n// ------------------------------\n\n// Read the lead from the previous node\nconst lead = $json.body ?? $json;\n\n// Normalize the lead\nreturn {\n  json: {\n    lead: {\n      fullName: String(lead.fullName).trim(),\n      email: String(lead.email).trim().toLowerCase(),\n      phone: lead.phone ? String(lead.phone).trim() : null,\n      company: lead.company ? String(lead.company).trim() : null,\n      jobTitle: lead.jobTitle ? String(lead.jobTitle).trim() : null,\n      country: lead.country ? String(lead.country).trim() : null,\n      industry: lead.industry ? String(lead.industry).trim() : null,\n      companySize: lead.companySize ? String(lead.companySize).trim() : null,\n      serviceRequested: String(lead.serviceRequested).trim(),\n      estimatedBudgetUSD: Number(lead.estimatedBudgetUSD || 0),\n      projectDescription: lead.projectDescription\n        ? String(lead.projectDescription).trim()\n        : \"\",\n      preferredContactMethod: lead.preferredContactMethod\n        ? String(lead.preferredContactMethod).trim()\n        : \"Email\",\n      source: String(lead.source).trim(),\n      submittedAt: new Date().toISOString()\n    }\n  }\n};"
      },
