    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ------------------------------\n// Intelligent Lead Processing Platform\n// Validation Layer\n// ------------------------------\n\n// Read the lead from the Webhook body\nconst lead = $json.body ?? $json;\n\nconst errors = [];\n\n// Required fields\nconst requiredFields = [\n  \"fullName\",\n  \"email\",\n  \"serviceRequested\",\n  \"source\"\n];\n\n// Validate required fields\nfor (const field of requiredFields) {\n  if (\n    lead[field] === undefined ||\n    lead[field] === null ||\n    String(lead[field]).trim() === \"\"\n  ) {\n    errors.push(`${field} is required.`);\n  }\n}\n\n// Validate email format\nif (lead.email) {\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n  if (!emailRegex.test(lead.email)) {\n    errors.push(\"Email format is invalid.\");\n  }\n}\n\n// Validate budget\nif (\n  lead.estimatedBudgetUSD !== undefined &&\n  lead.estimatedBudgetUSD !== null &&\n  lead.estimatedBudgetUSD !== \"\"\n) {\n  if (isNaN(Number(lead.estimatedBudgetUSD))) {\n    errors.push(\"Estimated budget must be a number.\");\n  }\n}\n\n// Return validation result\nreturn {\n  json: {\n    ...lead,\n    validation: {\n      isValid: errors.length === 0,\n      errors\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
